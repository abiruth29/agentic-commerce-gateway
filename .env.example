# Copy to .env for local development. Never commit .env.
# In deployment these are set as host secrets, not as files.

# Razorpay — test mode keys from the dashboard. No KYC required for test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Gemini — used by Layer 2 semantic screening, on the content path only.
# Keys: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required whenever MOCK_MODE is false. There is deliberately no default: the
# old one (gemini-2.0-flash) was shut down, and a retired model makes every
# call fail. Pick a current stable Flash model id from Google's Gemini API
# model list and paste it exactly.
GEMINI_MODEL=

# When true, all outbound integrations use deterministic fakes instead of the
# real providers. This is what the evaluation harness runs against.
MOCK_MODE=true
